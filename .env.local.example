# Copy to .env.local and fill from your Supabase project settings (API section).
# Never commit .env.local. The service role key is server-only and must never
# be exposed to the browser or placed in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The public privacy notice version the app records against consent.
NEXT_PUBLIC_PRIVACY_NOTICE_VERSION=2026-08-v1
